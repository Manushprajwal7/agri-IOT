# ==============================================================================
# AgriSense & AgriMarket AI — Environment Configuration (.env.example)
# ==============================================================================

APP_ENV=development
APP_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# 1. Database
DATABASE_URL=postgresql://user:password@host:5432/postgres

# 2. TrueForge / TrueFoundry Agent Harness
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_API_KEY=
TRUEFORGE_AGENT_ID=agrisense-farm-operator
TRUEFORGE_MODEL_PROFILE=truefoundry/gemini-2-5-flash

# 3. Model Engine
OLLAMA_BASE_URL=http://localhost:11434/v1
GEMMA_MODEL=gemma4:e4b
LLM_PROVIDER=gemma_local
LLM_MODEL=gemma4:e4b

# 4. Sandbox
DAYTONA_API_KEY=your_daytona_api_key_here
DAYTONA_SERVER_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# 5. n8n
N8N_BASE_URL=https://your-workspace.app.n8n.cloud
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# 6. Cognee
COGNEE_BASE_URL=https://tenant.aws.cognee.ai
COGNEE_PROJECT_ID=your_project_id
COGNEE_API_KEY=your_cognee_api_key

# 7. Sarvam AI Multilingual Indic Voice (KN, HI, EN, TA, TE)
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3

# 8. CALL-E Voice Call Agent (https://api.heycall-e.com)
CALLE_API_KEY=your_calle_api_key_here
CALLE_BASE_URL=https://api.heycall-e.com
FARMER_PHONE_NUMBER=+919844775528
SUPPLIER_PHONE_NUMBER=+919844775528
ALERT_PHONE_NUMBER=+919844775528

# 9. Telegram & Ledger
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
GOOGLE_SHEET_ID=your_sheet_id
SPREADSHEET_WEBHOOK_URL=https://docs.google.com/spreadsheets/d/...
